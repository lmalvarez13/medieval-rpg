# ============================
# Root-level .gitignore
# For Unity 2018.3.14f1 project in RPG_Project/
# Keeps build/ and docs/ tracked
# ============================

# --- Unity Project (RPG_Project) ---
RPG_Project/[Ll]ibrary/
RPG_Project/[Tt]emp/
RPG_Project/[Oo]bj/
RPG_Project/[Bb]uild/
RPG_Project/[Bb]uilds/
RPG_Project/[Ll]ogs/
RPG_Project/[Mm]emoryCaptures/
RPG_Project/[Uu]ser[Ss]ettings/
RPG_Project/[Pp]ackages/com.unity.package-manager/manifest.json.meta

# Autogenerated project files
RPG_Project/*.csproj
RPG_Project/*.unityproj
RPG_Project/*.sln
RPG_Project/*.suo
RPG_Project/*.tmp
RPG_Project/*.user
RPG_Project/*.userprefs
RPG_Project/*.pidb
RPG_Project/*.booproj
RPG_Project/*.svd

# Unity generated crash reports
RPG_Project/sysinfo.txt

# Unity Collaborate files
RPG_Project/[Cc]ollab/

# Cache directories
RPG_Project/[Aa]sset[Ss]tore/
RPG_Project/[Pp]ackages/com.unity.package-manager/[Cc]ache/
RPG_Project/.vs/
RPG_Project/.idea/

# --- OS junk files ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# --- Logs and temporary files ---
*.log
*.stackdump
*.bak
*.tmp

# --- Unity Addressables ---
RPG_Project/[Aa]ssets/AddressableAssetsData/*/*.bin*
RPG_Project/[Aa]ssets/StreamingAssets/aa/*

# --- Ignore only local builds inside project ---
# (Keep external builds in /build and /docs)
RPG_Project/[Bb]uild*/**

# --- JetBrains Rider ---
RPG_Project/.idea/
RPG_Project/.idea/*

# --- Visual Studio Code ---
RPG_Project/.vscode/

# --- Rider and VS caches ---
RPG_Project/.vs/
RPG_Project/.gradle/

# ============================
# Keep these folders tracked
# ============================
!build/
!docs/

# Optionally ignore any temporary zip or backup exports
*.zip
*.tar
*.tar.gz
*.7z